{
  "name": "RescueBox Hackathon",
  // Using docker-compose to provide both app container and postgres service
  "dockerComposeFile": [
    "./docker-compose.yml"
  ],
  "service": "app",
  "workspaceFolder": "/home/rbuser/RescueBox",
  "remoteUser": "rbuser",
  // Note: Volume mounting is handled by docker-compose.yml
  // Files for plugins must be in /home/rbuser/RescueBox/
  // example /home/rbuser/RescueBox/src/audio-transcription/tests/ is input directory for audio transcription plugin
  // example /home/rbuser/RescueBox/src/deepfake-detection/sample_images/ is input directory for deepfake detection plugin
  // and Path to the output file "/tmp" or any other directory in the container
  "remoteEnv": {
    "POETRY_VIRTUALENVS_IN_PROJECT": "false",
    "POETRY_VIRTUALENVS_CREATE": "true",
    "POETRY_VIRTUALENVS_PATH": "/home/rbuser/venv",
    "DISPLAY": "host.docker.internal:0.0",
    "DATABASE_URL": "postgresql://rbuser:rescue@db:5432/rescuebox"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [
    8000,
    5433
  ],
  "postStartCommand": "poetry env info ",
  "postAttachCommand": "/bin/bash"
  // start pre req ollama server followed by rescuebox backend server
  // nohup bash -c "ollama serve" &
  // run_server
}