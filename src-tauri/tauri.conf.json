{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RescueBox",
  "version": "3.1.0",
  "identifier": "rescuebox-desktop",
  "build": {
    "frontendDist": "../src-tauri/ui-dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": {
      "script": "ping 127.0.0.1 -n 4 > NUL && start /B poetry run python backend/server.py && poetry run python frontend/main.py",
      "cwd": ".",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "poetry run pyinstaller --noconfirm --distpath src-tauri-frontend frontend.spec && poetry run pyinstaller --noconfirm --distpath src-tauri-backend backend.spec &&  move src-tauri-frontend\\frontend src-tauri && move src-tauri\\frontend\\frontend.exe src-tauri\\frontend\\frontend-x86_64-pc-windows-msvc.exe && move src-tauri-backend\\rescuebox src-tauri && move src-tauri\\rescuebox src-tauri\\backend && move src-tauri\\backend\\rescuebox.exe src-tauri\\backend\\rescuebox-x86_64-pc-windows-msvc.exe",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RescueBox",
        "url": "http://127.0.0.1:8080/",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "RescueBox",
        "url": "splashscreen.html",
        "width": 440,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "certificateThumbprint": "721DC6509D5643BC3232C43D3A27EF8AF06A1651",
      "digestAlgorithm": "sha1",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "template": "nsis/custom.nsi",
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "template": "./wix/main.wxs",
        "fragmentPaths": ["./models_config.wxs"],
        "componentRefs": ["ModelsZipSourceRegistry"]
      }
    },
    "resources": {
      "frontend/": "frontend",
      "backend/": "backend",
      "demo/": "demo"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
