<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!-- Models folder = MSI launch folder ([SourceDir]), not install destination [INSTALLDIR]. -->
        <Property Id="MODELS_ZIP_SOURCE" Secure="yes" />

        <SetProperty Id="MODELS_ZIP_SOURCE"
                     Value="[SourceDir]"
                     After="AppSearch"
                     Sequence="ui">NOT Installed</SetProperty>

        <!-- Type-51 CA: second SetProperty on same Id would duplicate SetMODELS_ZIP_SOURCE at link time. -->
        <CustomAction Id="SetModelsZipSourceOnExecute"
                      Property="MODELS_ZIP_SOURCE"
                      Value="[SourceDir]" />

        <DirectoryRef Id="INSTALLDIR">
            <Component Id="ModelsZipSourceRegistry" Guid="A7C4E2F1-9B3D-4E8A-91F6-2D5C8B0E4A17" Win64="yes">
                <RegistryValue Root="HKCU"
                               Key="Software\rescuebox-desktop\RescueBox"
                               Name="ModelsZipSource"
                               Type="string"
                               Value="[MODELS_ZIP_SOURCE]"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Runtime ONNX under [INSTALLDIR]backend\_internal is not in the MSI; remove on uninstall. -->
        <!-- Runtime ONNX under %APPDATA%\RescueBox-Desktop is not in the MSI; remove on uninstall. -->
        <Property Id="REMOVEBACKENDDIRCMD" Secure="yes" />

        <SetProperty Id="REMOVEBACKENDDIRCMD"
                     Value="&quot;[SystemFolder]cmd.exe&quot; /c if exist &quot;[INSTALLDIR]&quot; rmdir /s /q &quot;[INSTALLDIR]/backend&quot; &amp; if exist &quot;[AppDataFolder]RescueBox-Desktop&quot; rmdir /s /q &quot;[AppDataFolder]RescueBox-Desktop&quot;"
                     Before="RemoveExtraFiles"
                     Sequence="execute">(REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)</SetProperty>

        <CustomAction Id="RemoveExtraFiles"
                      Directory="INSTALLDIR"
                      ExeCommand="[REMOVEBACKENDDIRCMD]"
                      Execute="immediate"
                      Return="ignore"
                      Impersonate="no" />

        <InstallExecuteSequence>
            <Custom Action="SetModelsZipSourceOnExecute"
                    Before="InstallFiles">NOT REMOVE AND NOT MODELS_ZIP_SOURCE</Custom>
            <Custom Action="RemoveExtraFiles" After="RemoveFiles">
                (REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)
            </Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
