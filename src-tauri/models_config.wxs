<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!-- Models folder = MSI launch folder ([SourceDir]), not install destination [INSTALLDIR]. -->
        <Property Id="MODELS_ZIP_SOURCE" Secure="yes" />

        <SetProperty Id="MODELS_ZIP_SOURCE"
                     Value="[SourceDir]"
                     After="AppSearch"
                     Sequence="ui">NOT Installed</SetProperty>

        <!-- Type-51 CA: second SetProperty on same Id would duplicate SetMODELS_ZIP_SOURCE at link time. -->
        <CustomAction Id="SetModelsZipSourceOnExecute"
                      Property="MODELS_ZIP_SOURCE"
                      Value="[SourceDir]" />

        <DirectoryRef Id="INSTALLDIR">
            <Component Id="ModelsZipSourceRegistry" Guid="A7C4E2F1-9B3D-4E8A-91F6-2D5C8B0E4A17" Win64="yes">
                <RegistryValue Root="HKCU"
                               Key="Software\RescueBox\RescueBox"
                               Name="ModelsZipSource"
                               Type="string"
                               Value="[MODELS_ZIP_SOURCE]"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Fragment must declare SystemFolder for deferred ExeCommand CAs (see main.wxs WebView2 CAs). -->
        <DirectoryRef Id="TARGETDIR">
            <Directory Id="SystemFolder" Name="SystemFolder" />
        </DirectoryRef>

        <!-- RemoveFiles only drops MSI-registered files; rd removes runtime data under Local\RescueBox. -->
        <CustomAction Id="RemoveRescueBoxLocalAppDataDeferred"
                      Directory="SystemFolder"
                      Execute="deferred"
                      Impersonate="yes"
                      Return="ignore"
                      ExeCommand="cmd.exe /c rd /s /q &quot;%LOCALAPPDATA%\RescueBox&quot;" />

        <!-- Prior releases used Roaming\AppData\RescueBox for install/logs. -->
        <CustomAction Id="RemoveRescueBoxLegacyRoamingDeferred"
                      Directory="SystemFolder"
                      Execute="deferred"
                      Impersonate="yes"
                      Return="ignore"
                      ExeCommand="cmd.exe /c rd /s /q &quot;%APPDATA%\RescueBox&quot;" />

        <InstallExecuteSequence>
            <Custom Action="SetModelsZipSourceOnExecute"
                    Before="InstallFiles">NOT REMOVE AND NOT MODELS_ZIP_SOURCE</Custom>
            <Custom Action="RemoveRescueBoxLocalAppDataDeferred"
                    After="RemoveFolders">(REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)</Custom>
            <Custom Action="RemoveRescueBoxLegacyRoamingDeferred"
                    After="RemoveRescueBoxLocalAppDataDeferred">(REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)</Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
