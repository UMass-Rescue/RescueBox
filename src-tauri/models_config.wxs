<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!-- Same pattern as WixUI InstallDir: indirect PathEdit + Directory id + SetDirectory -->
        <DirectoryRef Id="TARGETDIR">
            <Directory Id="MODELS_ZIP_DIR" Name="ModelsZipSource" />
        </DirectoryRef>

        <Property Id="MODELS_ZIP_SOURCE" Secure="yes" Value="MODELS_ZIP_DIR" />
        <Property Id="MODELS_ZIP_PATH" Secure="yes" />
        <!-- Per-machine MSIs often default DesktopFolder to Public Desktop; prefer the installing user's Desktop. -->
        <Property Id="MODELS_ZIP_DEFAULT_DIR" Secure="yes">
            <RegistrySearch Id="ModelsZipUserDesktopDir"
                            Root="HKCU"
                            Key="Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders"
                            Name="Desktop"
                            Type="raw" />
        </Property>
        <!-- UI only: do not reset on execute (that overwrote Browse). Skip after Next saved MODELS_ZIP_PATH. -->
        <SetDirectory Id="MODELS_ZIP_DIR" Value="[MODELS_ZIP_DEFAULT_DIR]" Sequence="ui">MODELS_ZIP_DEFAULT_DIR AND NOT MODELS_ZIP_PATH</SetDirectory>

        <UI>
            <Dialog Id="ModelSourceDlg" Width="370" Height="270" Title="RescueBox ONNX models">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                         Text="!(loc.InstallDirDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes"
                         NoPrefix="yes" Text="{\WixUI_Font_Title}ONNX model files" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes"
                         NoPrefix="yes" Text="{\WixUI_Font_Title}RescueBox" />
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="ModelPathLabel" Type="Text" X="20" Y="60" Width="330" Height="30"
                         Text="Folder that contains models.zip or rb_3.1_onnx_models.zip (Browse default: your Desktop)." />
                <Control Id="ModelPathEdit" Type="PathEdit" X="20" Y="95" Width="260" Height="18"
                         Property="MODELS_ZIP_SOURCE" Indirect="yes" />
                <Control Id="Browse" Type="PushButton" X="285" Y="94" Width="56" Height="17"
                         Text="Browse" />
            </Dialog>

            <!-- Same controls as WixUI BrowseDlg; labels describe ONNX models folder, not install destination. -->
            <Dialog Id="ModelsBrowseDlg" Width="370" Height="270" Title="Select RescueBox install folder">
                <Control Id="PathEdit" Type="PathEdit" X="25" Y="202" Width="320" Height="18"
                         Property="_BrowseProperty" Indirect="yes" />
                <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" Default="yes" Text="OK">
                    <Publish Event="SetTargetPath" Value="[_BrowseProperty]">1</Publish>
                    <Publish Event="EndDialog" Value="Return">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
                    <Publish Event="Reset" Value="0">1</Publish>
                    <Publish Event="EndDialog" Value="Return">1</Publish>
                </Control>
                <Control Id="ComboLabel" Type="Text" X="25" Y="58" Width="44" Height="10" TabSkip="no" Text="&amp;Look in:" />
                <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="55" Width="220" Height="80"
                         Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes">
                    <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
                </Control>
                <Control Id="WixUI_Bmp_Up" Type="PushButton" X="298" Y="55" Width="19" Height="19"
                         ToolTip="Up one folder" Icon="yes" FixedSize="yes" IconSize="16" Text="!(loc.BrowseDlgWixUI_Bmp_Up)">
                    <Publish Event="DirectoryListUp" Value="0">1</Publish>
                </Control>
                <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="83" Width="320" Height="98"
                         Property="_BrowseProperty" Sunken="yes" Indirect="yes" TabSkip="no" />
                <Control Id="PathLabel" Type="Text" X="25" Y="190" Width="320" Height="10" TabSkip="no"
                         Text="Models folder:" />
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                         Text="!(loc.InstallDirDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="30" Transparent="yes"
                         NoPrefix="yes"
                         Text="Choose the folder that contains models.zip or rb_3.1_onnx_models.zip." />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="260" Height="15" Transparent="yes" NoPrefix="yes"
                         Text="{\WixUI_Font_Title}ONNX models folder" />
            </Dialog>
        </UI>

        <DirectoryRef Id="INSTALLDIR">
            <Component Id="ModelsZipSourceRegistry" Guid="A7C4E2F1-9B3D-4E8A-91F6-2D5C8B0E4A17" Win64="yes">
                <RegistryValue Root="HKCU"
                               Key="Software\rescuebox-desktop\RescueBox"
                               Name="ModelsZipSource"
                               Type="string"
                               Value="[MODELS_ZIP_PATH]"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Runtime ONNX extract under [INSTALLDIR]backend\_internal is not in the MSI cabinet. -->
        <CustomAction Id="RemoveExtractedOnnxModels"
                      Script="vbscript"
                      Execute="immediate"
                      Impersonate="no"
                      Return="ignore">
            <![CDATA[
On Error Resume Next
Dim fs, installdir, internal
Set fs = CreateObject("Scripting.FileSystemObject")
installdir = Session.Property("INSTALLFOLDER")
If Len(installdir) = 0 Then Exit Sub
If Not fs.FolderExists(installdir) Then Exit Sub
internal = fs.BuildPath(fs.BuildPath(installdir, "backend"), "_internal")
If fs.FolderExists(internal) Then fs.DeleteFolder internal, True
            ]]>
        </CustomAction>

        <InstallExecuteSequence>
            <Custom Action="RemoveExtractedOnnxModels"
                    After="RemoveFiles">REMOVE~="ALL"</Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
